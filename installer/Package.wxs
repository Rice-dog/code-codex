<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Code-Codex"
    Manufacturer="Code-Codex contributors"
    Version="$(var.ProductVersion)"
    UpgradeCode="{0437781B-3005-4322-A8C7-932CCE4914BA}"
    Language="1033"
    Codepage="936"
    Scope="perUser"
    Compressed="yes">

    <SummaryInformation
      Description="Live workspace explorer and bounded file editor for Codex Desktop"
      Manufacturer="Code-Codex contributors" />

    <!-- ProductLanguage identifies the MSI database; application UI uses its own
         strict preference. Codepage936 supports the Chinese/English dialog text. -->
    <Property Id="CODECODEXUILANGUAGE" Secure="yes" />
    <Property Id="CODECODEXUILANGUAGEREVISION" Secure="yes" />
    <Property Id="CODECODEXUILANGUAGEINITIALIZED" Secure="yes" />
    <Property Id="CCLANGYES" Value="Yes" />
    <Property Id="CCLANGNO" Value="No" />
    <Property Id="CCLANGIGNORE" Value="Ignore" />
    <Property Id="CCLANGOK" Value="OK" />
    <Property Id="CCLANGRETRY" Value="Retry" />
    <Property Id="CCLANGCANCEL" Value="Cancel" />
    <Property Id="CCLANGFINISH" Value="Finish" />
    <Property Id="CCLANGFILEINUSE" Value="Close the applications below, then retry." />
    <Property Id="CCLANGDOWNGRADE" Value="A newer version of Code-Codex is already installed." />
    <Property Id="CCLANGCROSSFORMAT" Value="A standalone installation of Code-Codex is already present. Uninstall it through Windows Installed apps before installing the MSI." />
    <Property Id="DefaultUIFont" Value="CodeCodexUIFont" />
    <CustomAction Id="InitializeUiLanguage" BinaryRef="SettingsCleanupCustomActionBinary" DllEntry="InitializeUiLanguage" Execute="immediate" Return="check" />
    <CustomAction Id="CommitUiLanguage" FileRef="ShortcutIntegrationExecutable"
      ExeCommand="language --install-root &quot;[INSTALLFOLDER].&quot; --locale &quot;[CODECODEXUILANGUAGE]&quot; --expected-revision &quot;[CODECODEXUILANGUAGEREVISION]&quot;"
      Execute="deferred" Impersonate="yes" Return="check" />
    <UI>
      <TextStyle Id="CodeCodexUIFont" FaceName="Segoe UI" Size="9" />
      <Dialog Id="CodeCodexLanguageDialog" Width="370" Height="190" Title="Code-Codex">
        <Control Id="HeadingEn" Type="Text" X="20" Y="18" Width="330" Height="26" Text="Code-Codex Setup" ShowCondition="CODECODEXUILANGUAGE = &quot;en&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;en&quot;" />
        <Control Id="HeadingZh" Type="Text" X="20" Y="18" Width="330" Height="26" Text="Code-Codex 安装" ShowCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;" />
        <Control Id="LanguageLabel" Type="Text" X="20" Y="62" Width="120" Height="18" Text="语言 / Language" />
        <Control Id="LanguageChoice" Type="ComboBox" X="150" Y="57" Width="190" Height="60" Property="CODECODEXUILANGUAGE" ComboList="yes" Sorted="yes">
          <ComboBox Property="CODECODEXUILANGUAGE"><ListItem Value="zh-CN" Text="中文（简体）" /><ListItem Value="en" Text="English" /></ComboBox>
        </Control>
        <Control Id="InstallEn" Type="PushButton" X="252" Y="145" Width="90" Height="25" Text="Install" DefaultCondition="CODECODEXUILANGUAGE = &quot;en&quot;" ShowCondition="CODECODEXUILANGUAGE = &quot;en&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;en&quot;"><Publish Event="DoAction" Value="InitializeUiLanguage" Order="1" /><Publish Order="2" Event="EndDialog" Value="Return" /></Control>
        <Control Id="InstallZh" Type="PushButton" X="252" Y="145" Width="90" Height="25" Text="安装" DefaultCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" ShowCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;"><Publish Event="DoAction" Value="InitializeUiLanguage" Order="1" /><Publish Order="2" Event="EndDialog" Value="Return" /></Control>
        <Control Id="CancelEn" Type="PushButton" X="150" Y="145" Width="90" Height="25" Text="Cancel" Cancel="yes" ShowCondition="CODECODEXUILANGUAGE = &quot;en&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;en&quot;"><Publish Event="DoAction" Value="InitializeUiLanguage" Order="1" /><Publish Order="2" Event="EndDialog" Value="Exit" /></Control>
        <Control Id="CancelZh" Type="PushButton" X="150" Y="145" Width="90" Height="25" Text="取消" ShowCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;"><Publish Event="DoAction" Value="InitializeUiLanguage" Order="1" /><Publish Order="2" Event="EndDialog" Value="Exit" /></Control>
      </Dialog>
      <Property Id="ErrorDialog" Value="CodeCodexErrorDialog" />
      <Dialog Id="CodeCodexErrorDialog" Width="370" Height="180" Title="Code-Codex" ErrorDialog="yes">
        <Control Id="ErrorText" Type="Text" TabSkip="no" X="20" Y="20" Width="330" Height="100" NoPrefix="yes" Text="[ErrorText]" />
        <Control Id="Y" Type="PushButton" X="250" Y="140" Width="90" Height="24" Text="[CCLANGYES]"><Publish Event="EndDialog" Value="ErrorYes" /></Control>
        <Control Id="A" Type="PushButton" X="250" Y="140" Width="90" Height="24" Text="[CCLANGCANCEL]"><Publish Event="EndDialog" Value="ErrorAbort" /></Control>
        <Control Id="C" Type="PushButton" X="250" Y="140" Width="90" Height="24" Text="[CCLANGCANCEL]"><Publish Event="EndDialog" Value="ErrorCancel" /></Control>
        <Control Id="I" Type="PushButton" X="250" Y="140" Width="90" Height="24" Text="[CCLANGIGNORE]"><Publish Event="EndDialog" Value="ErrorIgnore" /></Control>
        <Control Id="N" Type="PushButton" X="250" Y="140" Width="90" Height="24" Text="[CCLANGNO]"><Publish Event="EndDialog" Value="ErrorNo" /></Control>
        <Control Id="O" Type="PushButton" X="250" Y="140" Width="90" Height="24" Text="[CCLANGOK]"><Publish Event="EndDialog" Value="ErrorOk" /></Control>
        <Control Id="R" Type="PushButton" X="250" Y="140" Width="90" Height="24" Text="[CCLANGRETRY]"><Publish Event="EndDialog" Value="ErrorRetry" /></Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="370" Height="230" Title="Code-Codex" KeepModeless="yes">
        <Control Id="Description" Type="Text" X="20" Y="15" Width="330" Height="38" Text="[CCLANGFILEINUSE]" />
        <Control Id="List" Type="ListBox" X="20" Y="60" Width="330" Height="100" Property="FileInUseProcess" Sunken="yes" TabSkip="yes" />
        <Control Id="Retry" Type="PushButton" X="260" Y="185" Width="90" Height="24" Text="[CCLANGRETRY]" Default="yes" Cancel="yes"><Publish Event="EndDialog" Value="Retry" /></Control>
        <Control Id="Ignore" Type="PushButton" X="150" Y="185" Width="90" Height="24" Text="[CCLANGIGNORE]"><Publish Event="EndDialog" Value="Ignore" /></Control>
        <Control Id="Exit" Type="PushButton" X="40" Y="185" Width="90" Height="24" Text="[CCLANGCANCEL]"><Publish Event="EndDialog" Value="Exit" /></Control>
      </Dialog>
      <Dialog Id="FatalError" Width="370" Height="160" Title="Code-Codex">
        <Control Id="MessageEn" Type="Text" X="20" Y="25" Width="330" Height="60" Text="Installation failed. See the installer log for details." ShowCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" />
        <Control Id="MessageZh" Type="Text" X="20" Y="25" Width="330" Height="60" Text="安装失败，请查看安装日志。" ShowCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;" />
        <Control Id="Finish" Type="PushButton" X="250" Y="115" Width="90" Height="24" Text="[CCLANGFINISH]" Default="yes" Cancel="yes"><Publish Event="EndDialog" Value="Return" /></Control>
      </Dialog>
      <Dialog Id="UserExit" Width="370" Height="160" Title="Code-Codex">
        <Control Id="MessageEn" Type="Text" X="20" Y="25" Width="330" Height="60" Text="Installation cancelled." ShowCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" />
        <Control Id="MessageZh" Type="Text" X="20" Y="25" Width="330" Height="60" Text="安装已取消。" ShowCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;" />
        <Control Id="Finish" Type="PushButton" X="250" Y="115" Width="90" Height="24" Text="[CCLANGFINISH]" Default="yes" Cancel="yes"><Publish Event="EndDialog" Value="Return" /></Control>
      </Dialog>
      <Dialog Id="ExitDialog" Width="370" Height="160" Title="Code-Codex">
        <Control Id="MessageEn" Type="Text" X="20" Y="25" Width="330" Height="60" Text="Installation complete." ShowCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" />
        <Control Id="MessageZh" Type="Text" X="20" Y="25" Width="330" Height="60" Text="安装完成。" ShowCondition="CODECODEXUILANGUAGE = &quot;zh-CN&quot;" HideCondition="CODECODEXUILANGUAGE &lt;&gt; &quot;zh-CN&quot;" />
        <Control Id="Finish" Type="PushButton" X="250" Y="115" Width="90" Height="24" Text="[CCLANGFINISH]" Default="yes" Cancel="yes"><Publish Event="EndDialog" Value="Return" /></Control>
      </Dialog>
      <AdminUISequence>
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
      </AdminUISequence>
      <InstallUISequence>
        <Show Dialog="FatalError" OnExit="error" />
        <Show Dialog="UserExit" OnExit="cancel" />
        <Show Dialog="ExitDialog" OnExit="success" />
        <Custom Action="InitializeUiLanguage" After="AppSearch" />
        <Show Dialog="CodeCodexLanguageDialog" After="CostFinalize" Condition="NOT Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      </InstallUISequence>
    </UI>

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="[CCLANGDOWNGRADE]"
      Schedule="afterInstallFinalize" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon" SourceFile="$(var.UninstallBinaryPath)" />

    <Binary
      Id="SettingsCleanupCustomActionBinary"
      SourceFile="$(var.SettingsCleanupCAPath)" />
    <CustomAction
      Id="CleanupMsiSettings"
      BinaryRef="SettingsCleanupCustomActionBinary"
      DllEntry="CleanupMsiSettings"
      Execute="immediate"
      Impersonate="yes"
      Return="check" />
    <CustomAction
      Id="BlockCrossFormatInstall"
      BinaryRef="SettingsCleanupCustomActionBinary"
      DllEntry="BlockCrossFormatInstall"
      Execute="immediate"
      Impersonate="yes"
      Return="check" />

    <!-- INSTALLFOLDER ends with a backslash; append a dot so it cannot escape the closing command-line quote. -->
    <CustomAction
      Id="RollbackCodexShortcutInstall"
      FileRef="ShortcutIntegrationExecutable"
      ExeCommand="rollback-install --install-root &quot;[INSTALLFOLDER].&quot;"
      Execute="rollback"
      Impersonate="yes"
      Return="ignore" />
    <CustomAction Id="InitializeCentralStorage" FileRef="ShortcutIntegrationExecutable"
      ExeCommand="initialize-storage --install-root &quot;[INSTALLFOLDER].&quot;"
      Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction
      Id="PrepareCodexShortcutInstall"
      FileRef="ShortcutIntegrationExecutable"
      ExeCommand="prepare-install --install-root &quot;[INSTALLFOLDER].&quot;"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />
    <CustomAction
      Id="InstallCodexShortcut"
      FileRef="ShortcutIntegrationExecutable"
      ExeCommand="install --install-root &quot;[INSTALLFOLDER].&quot; --version &quot;$(var.ProductVersion)&quot; --preserve-legacy"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />
    <CustomAction
      Id="CommitCodexShortcutInstall"
      FileRef="ShortcutIntegrationExecutable"
      ExeCommand="commit-install --install-root &quot;[INSTALLFOLDER].&quot;"
      Execute="commit"
      Impersonate="yes"
      Return="ignore" />
    <CustomAction
      Id="RollbackCodexShortcutRemoval"
      FileRef="ShortcutIntegrationExecutable"
      ExeCommand="install --install-root &quot;[INSTALLFOLDER].&quot; --version &quot;$(var.ProductVersion)&quot;"
      Execute="rollback"
      Impersonate="yes"
      Return="ignore" />
    <CustomAction
      Id="RestoreCodexShortcut"
      FileRef="ShortcutIntegrationExecutable"
      ExeCommand="restore --install-root &quot;[INSTALLFOLDER].&quot;"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />
    <CustomAction
      Id="ActivateRunningCodeCodex"
      FileRef="CommandLineExecutable"
      ExeCommand="activate"
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="InitializeUiLanguage" After="AppSearch" />
      <Custom Action="CommitUiLanguage" After="InstallCodexShortcut" Condition="NOT Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="InitializeCentralStorage" After="InstallFiles" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom
        Action="BlockCrossFormatInstall"
        Before="InstallInitialize"
        Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom
        Action="RollbackCodexShortcutInstall"
        After="InitializeCentralStorage"
        Condition="NOT Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom
        Action="PrepareCodexShortcutInstall"
        After="RollbackCodexShortcutInstall"
        Condition="NOT Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom
        Action="InstallCodexShortcut"
        After="PrepareCodexShortcutInstall"
        Condition="NOT Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom
        Action="CommitCodexShortcutInstall"
        After="CommitUiLanguage"
        Condition="NOT Installed AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom
        Action="ActivateRunningCodeCodex"
        After="InstallFinalize"
        Condition="NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom
        Action="RollbackCodexShortcutRemoval"
        Before="RestoreCodexShortcut"
        Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom
        Action="RestoreCodexShortcut"
        Before="RemoveFiles"
        Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom
        Action="CleanupMsiSettings"
        After="InstallFinalize"
        Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <Property Id="REGISTEREDINSTALLFOLDER"><RegistrySearch Id="CurrentStorageRoot" Root="HKCU" Key="Software\CodeCodex" Name="InstallPath" Type="raw" /></Property>
    <SetProperty Id="INSTALLFOLDER" Value="[REGISTEREDINSTALLFOLDER]" Before="CostInitialize" Condition="REGISTEREDINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <SetProperty
      Id="ARPINSTALLLOCATION"
      Value="[INSTALLFOLDER]"
      After="CostFinalize" />
    <Property Id="PORTABLEINSTALLDETECTED">
      <RegistrySearch
        Id="PortableInstallRegistrationSearch"
        Root="HKCU"
        Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\CodeCodex"
        Name="DisplayName"
        Type="raw" />
    </Property>
    <Launch
      Condition="Installed OR NOT PORTABLEINSTALLDETECTED"
      Message="[CCLANGCROSSFORMAT]" />

    <Feature Id="Complete" Title="Code-Codex" Level="1">
      <ComponentRef Id="ProductFiles" />
      <ComponentRef Id="RootLauncherPayload" />
      <ComponentRef Id="StorageLayoutMarker" />
      <ComponentRef Id="CommandLinePayload" />
      <ComponentRef Id="RuntimeLauncherPayload" />
      <ComponentRef Id="SettingsCleanup" />
    </Feature>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Code-Codex">
          <Component Id="StorageLayoutMarker" Guid="{F59A9C8C-C10C-46DB-A5D9-FF8D94C9E710}" Permanent="yes">
            <File Id="StorageLayoutFile" Source="$(var.StorageLayoutPath)" Name="storage-layout.json" />
            <RegistryValue Root="HKCU" Key="Software\CodeCodex\Storage" Name="Schema" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="RootLauncherPayload" Guid="$(var.RootLauncherComponentGuid)">
            <File
              Id="RootLauncherExecutable"
              Source="$(var.ShimBinaryPath)"
              Name="CodeCodex-$(var.ProductVersion).exe"
              Checksum="yes" />
            <RegistryValue
              Root="HKCU"
              Key="Software\CodeCodex\Versions\$(var.ProductVersion)"
              Name="RootLauncherPayload"
              Type="integer"
              Value="1"
              KeyPath="yes" />
          </Component>
          <Component Id="ProductFiles" Guid="{F44B8D83-89A2-4BE9-AAD9-5C8EE69496D8}">
            <File
              Id="ShortcutIntegrationExecutable"
              Source="$(var.ShortcutBinaryPath)"
              Name="CodeCodex.Shortcut.exe"
              Checksum="yes" />
            <File
              Id="UninstallExecutable"
              Source="$(var.UninstallBinaryPath)"
              Name="Uninstall-CodeCodex.exe"
              Checksum="yes" />
            <File
              Id="PortableUninstallScript"
              Source="$(var.UninstallScriptPath)"
              Name="Uninstall-CodeCodex.ps1" />
            <File
              Id="UninstallFinalizerScript"
              Source="$(var.FinalizerScriptPath)"
              Name="Finalize-Uninstall.ps1" />
            <File
              Id="BrandIconFile"
              Source="$(var.BrandIconPath)"
              Name="CodeCodex.Brand.png" />
            <File Id="CurrentVersionFile" Source="$(var.CurrentVersionPath)" Name="current-version" />
            <File Id="InstallTypeFile" Source="$(var.InstallTypePath)" Name="install-type" />
            <File Id="ReadmeFile" Source="$(var.ReadmePath)" Name="README.md" />
            <File Id="LicenseFile" Source="$(var.LicensePath)" Name="LICENSE" />
            <File
              Id="ThirdPartyLicensesFile"
              Source="$(var.ThirdPartyLicensesPath)"
              Name="THIRD_PARTY_LICENSES.txt" />
            <File
              Id="VisualEffectNoticesEnFile"
              Source="$(var.VisualEffectNoticesEnPath)"
              Name="THIRD_PARTY_NOTICES_EN.md" />
            <File
              Id="VisualEffectNoticesZhFile"
              Source="$(var.VisualEffectNoticesZhPath)"
              Name="THIRD_PARTY_NOTICES_ZH_CN.md" />
            <File Id="SbomFile" Source="$(var.SbomPath)" Name="sbom.spdx.json" />
            <RegistryValue
              Root="HKCU"
              Key="Software\CodeCodex"
              Name="InstallPath"
              Type="string"
              Value="[INSTALLFOLDER]"
              KeyPath="yes" />
            <RemoveFile
              Id="RemoveGeneratedCodexIcon"
              Name="Codex.ico"
              On="uninstall" />
            <RemoveFile
              Id="RemoveGeneratedOfficialCodexIcon"
              Name="Codex-Official.ico"
              On="uninstall" />
            <RemoveFile
              Id="RemoveLegacyRootCommandLine"
              Name="code-codex.exe"
              On="uninstall" />
            <RemoveFile
              Id="RemoveLegacyRootLauncher"
              Name="CodeCodex.exe"
              On="uninstall" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
          </Component>

          <Directory Id="VersionsFolder" Name="versions">
            <Directory Id="VersionFolder" Name="$(var.ProductVersion)">
              <Component Id="CommandLinePayload" Guid="$(var.CommandLineComponentGuid)">
                <File
                  Id="CommandLineExecutable"
                  Source="$(var.BinaryPath)"
                  Name="code-codex.exe"
                  Checksum="yes" />
                <RegistryValue
                  Root="HKCU"
                  Key="Software\CodeCodex\Versions\$(var.ProductVersion)"
                  Name="CommandLinePayload"
                  Type="integer"
                  Value="1"
                  KeyPath="yes" />
                <RemoveFolder Id="RemoveVersionFolder" Directory="VersionFolder" On="uninstall" />
                <RemoveFolder Id="RemoveVersionsFolder" Directory="VersionsFolder" On="uninstall" />
              </Component>
              <Component Id="RuntimeLauncherPayload" Guid="$(var.RuntimeLauncherComponentGuid)">
                <File
                  Id="RuntimeLauncherExecutable"
                  Source="$(var.GuiBinaryPath)"
                  Name="CodeCodex.exe"
                  Checksum="yes" />
                <RegistryValue
                  Root="HKCU"
                  Key="Software\CodeCodex\Versions\$(var.ProductVersion)"
                  Name="RuntimeLauncherPayload"
                  Type="integer"
                  Value="1"
                  KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>

        </Directory>
      </Directory>
      <Directory Id="SettingsFolder" Name="CodeCodex">
        <Component Id="SettingsCleanup" Guid="{E19D3378-5F12-4F11-A85A-8AC4318F831B}">
          <RemoveFolder Id="RemoveSettingsFolder" Directory="SettingsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\CodeCodex"
            Name="SettingsCleanup"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
